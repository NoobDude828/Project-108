# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local operational notes (server access / infra topology — keep out of git)
INFRA.local.md
*.local.md

# DK gateway docs are image PDFs that contain live X-Gravitee-Api-Key values
# (both the UAT and production keys) — never commit them.
Stripe Payment Processing API Documentation*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
